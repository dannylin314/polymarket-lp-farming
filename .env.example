# Copy to `.env` and fill in your own values. NEVER commit the real .env.
# The bot reads these from the environment (os.environ); the PowerShell launchers
# and docker-compose load them for you.

# ── Polymarket account (CLOB) ─────────────────────────────────────────────
# EOA private key that signs orders. Controls real funds — keep it secret.
POLY_PRIVATE_KEY=0xyourprivatekey
# Your Polymarket funder/proxy wallet address (public — the Gnosis Safe holding USDC).
POLY_FUNDER_ADDRESS=0xyourfunderaddress
# Signature type: 2 = Gnosis Safe proxy (Polymarket default), 1 = proxy, 0 = EOA.
POLY_SIGNATURE_TYPE=2

# ── Polymarket API credentials (L2 — derived from the key via the SDK) ─────
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# ── Builder API key (required for gasless merge/redeem of complete sets) ───
POLY_BUILDER_API_KEY=
POLY_BUILDER_SECRET=
POLY_BUILDER_PASSPHRASE=

# ── NordVPN service credentials (for the gluetun container only) ───────────
# NOT your Nord login — the "manual setup" service username/password from
# my.nordaccount.com. Only the farm container egresses through this VPN.
OPENVPN_USER=
OPENVPN_PASSWORD=
